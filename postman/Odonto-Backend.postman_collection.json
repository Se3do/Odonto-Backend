        {
          "name": "Auth",
          "item": [
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "",
                      "pm.test('Status code is 201', () => {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test('Response has user object', () => {",
                      "    pm.expect(res).to.have.property('user');",
                      "    pm.expect(res.user).to.have.property('id');",
                      "    pm.expect(res.user).to.have.property('username');",
                      "    pm.expect(res.user).to.have.property('email');",
                      "});",
                      "",
                      "pm.test('Response contains accessToken', () => {",
                      "    pm.expect(res).to.have.property('accessToken');",
                      "    pm.expect(res.accessToken).to.be.a('string').and.not.empty;",
                      "});",
                      "",
                      "pm.test('Response contains refreshToken', () => {",
                      "    pm.expect(res).to.have.property('refreshToken');",
                      "    pm.expect(res.refreshToken).to.be.a('string').and.not.empty;",
                      "});",
                      "",
                      "// Save tokens to environment",
                      "pm.environment.set('accessToken', res.accessToken);",
                      "pm.environment.set('refreshToken', res.refreshToken);",
                      "pm.environment.set('userToken', res.accessToken);",
                      "pm.environment.set('userId', res.user && res.user.id);"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "packages": {},
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
